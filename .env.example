# Copy this file to .env.local and fill in the values. Never commit .env.local.

# From Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# AI coach (free key from https://console.groq.com/keys). SERVER ONLY: no NEXT_PUBLIC_ prefix!
GROQ_API_KEY=YOUR-GROQ-KEY
# Optional: change the model if Groq retires this one (see console.groq.com/docs/models)
# GROQ_MODEL=llama-3.3-70b-versatile
